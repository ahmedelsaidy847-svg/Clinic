# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"
# اتصال مباشر للهجرات (على Neon/Vercel استخدم DATABASE_URL_UNPOOLED؛ محلياً نفس الرابط)
DATABASE_URL_UNPOOLED="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"

# مفتاح تشفير الجلسات (غيّره في الإنتاج) — أنشئ واحداً عبر: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"

# عنوان التطبيق
APP_URL="http://localhost:3000"

# ===== إعداد العيادة (مهم عند عمل نسخة لعيادة جديدة) =====
# اسم العيادة الذي يظهر في السيستم والمستندات
CLINIC_NAME="Smart Clinic"
CLINIC_PHONE=""
CLINIC_ADDRESS=""
# حساب المدير الأول (يُنشأ عند تشغيل seed) — غيّره لكل عيادة
ADMIN_EMAIL="admin@clinic.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="مدير النظام"
# بيانات تجريبية (طبيب + مرضى وهميون). للعيادة الحقيقية اجعلها false
SEED_DEMO="true"

# ===== مفاتيح اختيارية (تُستخدم في مراحل لاحقة) =====
# المساعد الذكي (المرحلة 8) — استخدم أحد المزودين
# 1) Anthropic Claude (مفتاح يبدأ بـ sk-ant-...)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""   # اختياري، افتراضي claude-sonnet-4-6
# 2) Google Gemini (بديل) — مفتاح من Google AI Studio
GEMINI_API_KEY=""
GEMINI_MODEL=""      # اختياري، افتراضي gemini-2.0-flash
# واتساب Cloud API (المرحلة 7)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# تخزين ملفات المرضى (Vercel Blob) — يُضبط تلقائياً عند تفعيل Blob في Vercel
BLOB_READ_WRITE_TOKEN=""
